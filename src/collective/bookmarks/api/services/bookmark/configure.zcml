<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <plone:service
      method="GET"
      factory=".get.BookmarkGet"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@bookmark"
      />

  <plone:service
      method="POST"
      factory=".post.BookmarkPost"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@bookmark"
      />

  <plone:service
      method="PUT"
      factory=".put.BookmarkPut"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@bookmark"
      />

  <plone:service
      method="DELETE"
      factory=".delete.BookmarkDelete"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@bookmark"
      />

</configure>
